{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.glidermcp/glider",
  "description": "Roslyn-powered C# code analysis server for LLMs. Supports stdio and HTTP transports.",
  "version": "6.4.2",
  "homepage": "https://glidermcp.com",
  "license": "Proprietary",
  "capabilities": {
    "tools": true,
    "resources": false,
    "prompts": false
  },
  "keywords": [
    "roslyn",
    "csharp",
    "dotnet",
    "code-analysis",
    "refactoring",
    "semantic-analysis",
    "mcp"
  ],
  "packages": [
    {
      "registryType": "nuget",
      "identifier": "glider",
      "version": "6.4.2",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [],
      "environmentVariables": []
    }
  ],
  "repository": {
    "url": "https://github.com/glidermcp/glidermcp.com",
    "source": "github"
  },
  "author": {
    "name": "Bogdan Novosad"
  }
}
