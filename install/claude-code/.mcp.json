{
  "mcpServers": {
    "glider": {
      "command": "glider",
      "args": [
        "--default-timeout",
        "30m"
      ]
    },
    "glider-trace": {
      "command": "glider-trace",
      "args": [
        "--default-timeout",
        "30m"
      ]
    },
    "tglider": {
      "command": "npx",
      "args": [
        "-y",
        "tglider",
        "--default-timeout",
        "30m"
      ]
    },
    "scout": {
      "command": "scout",
      "args": []
    }
  }
}
